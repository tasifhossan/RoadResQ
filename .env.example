# Runtime (Server-only) | Optional (has fallback) | Used for backend REST API proxy calls
BACKEND_URL=https://road-res-q-backend.vercel.app/api/v1

# Runtime (Server-only) | Optional | Used for demo user role logins
DEMO_PASSWORD=your-demo-password-here

# Build-time (Public) | Optional (has fallback) | Used for canonical metadata & sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Build-time (Public) | Optional | Contact email address for support and mailto links (empty by default)
NEXT_PUBLIC_CONTACT_EMAIL=

# Build-time (Public) | Optional | LinkedIn profile URL for footer social link (empty by default)
NEXT_PUBLIC_LINKEDIN_URL=

# Build-time (Public) | Optional | Developer or entity name displayed on privacy policy (e.g., operated by <name>)
NEXT_PUBLIC_DEVELOPER_NAME=
