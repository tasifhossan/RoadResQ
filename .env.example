# Runtime (Server-only) | Optional (has fallback) | Used for backend REST API proxy calls
BACKEND_URL=https://road-res-q-backend.vercel.app/api/v1

# Runtime (Server-only) | Optional | Used for demo user role logins
DEMO_PASSWORD=your-demo-password-here

# ── Gemini AI (Server-only — never use NEXT_PUBLIC_ prefix for these) ──
# Get a free key from https://aistudio.google.com/app/apikey
# ⚠ Free-tier prompts may be used by Google to improve products,
#   so personal data must never be sent (the app redacts PII automatically).
GEMINI_API_KEY=

# Runtime (Server-only) | Optional | Override default model (default: gemini-2.5-flash-lite)
GEMINI_MODEL=

# Runtime (Server-only) | Optional | Fallback model if primary returns 404
GEMINI_FALLBACK_MODEL=


# Build-time (Public) | Optional (has fallback) | Used for canonical metadata & sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Build-time (Public) | Optional | Contact email address for support and mailto links (empty by default)
NEXT_PUBLIC_CONTACT_EMAIL=

# Build-time (Public) | Optional | LinkedIn profile URL for footer social link (empty by default)
NEXT_PUBLIC_LINKEDIN_URL=

# Build-time (Public) | Optional | Developer or entity name displayed on privacy policy (e.g., operated by <name>)
NEXT_PUBLIC_DEVELOPER_NAME=

# Build-time (Public) | Optional | Google OAuth 2.0 Web Client ID for Google Sign-In (empty hides button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
